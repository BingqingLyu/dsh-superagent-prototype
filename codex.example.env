# Set these before first start; later installation settings use the original settings API.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# Optional: published interactive card template from cards/dingtalk-superagent.json.
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_ROBOT_NAME=Super agent
SUPERAGENT_REPOSITORY=/absolute/path/to/local/repository
SUPERAGENT_GITHUB_REPOSITORY=owner/repository
SUPERAGENT_GITHUB_CLI=gh
SUPERAGENT_STATE_DIR=/absolute/path/to/state-codex
SUPERAGENT_MAX_WORKERS=3
SUPERAGENT_PORT=3082
CODEX_BINARY=codex
CODEX_MODEL=gpt-6.1-sol
# read-only | workspace-write | danger-full-access (host execution without approval)
CODEX_SANDBOX=read-only
